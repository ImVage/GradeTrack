# Vorlage für Laufzeit-Einstellungen. Kopieren nach .env und Werte setzen:
#   cp .env.example .env
# .env ist per .gitignore und .dockerignore ausgeschlossen und landet weder im Repo noch im Image.
# Übergabe an den Container: docker run --env-file .env ...
#
# Hinweis: Die Secrets sind im Code noch fest eingetragen. Ab Phase 6 liest die App sie
# aus diesen Variablen und startet ohne sie nicht.

# Neu erzeugen z. B. mit: python -c "import secrets; print(secrets.token_urlsafe(32))"
GRADETRACK_SECRET_KEY=
GRADETRACK_ADMIN_API_TOKEN=
