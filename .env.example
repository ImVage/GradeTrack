# Vorlage für Laufzeit-Einstellungen. Kopieren nach .env und Werte setzen:
#   cp .env.example .env
# .env ist per .gitignore und .dockerignore ausgeschlossen und landet weder im Repo noch im Image.
# Übergabe an den Container: docker run --env-file .env ...

# Pflicht. Ohne Wert (mind. 32 Zeichen) startet die App nicht.
# Erzeugen z. B. mit: python -c "import secrets; print(secrets.token_urlsafe(32))"
GRADETRACK_SECRET_KEY=

# Beispielbenutzer und -noten beim Anlegen der Datenbank (bekannte Passwörter!).
# Nur für Demo und Tests auf 1 setzen. Ohne Beispieldaten einen Zugang anlegen mit:
#   python gradetrack.py --create-registrar <name>
GRADETRACK_DEMO_DATA=0

# Session-Cookie nur über HTTPS senden (Standard 1). Nur für lokale Tests über
# http:// ohne HTTPS-Proxy auf 0 setzen.
GRADETRACK_SECURE_COOKIES=1

# Nur für "python gradetrack.py" (Entwicklungsserver). Standard: 127.0.0.1, 5000, Debug aus.
# GRADETRACK_HOST=127.0.0.1
# GRADETRACK_PORT=5000
# GRADETRACK_DEBUG=0
